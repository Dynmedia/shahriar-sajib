# =============================================================================
# Example terraform.tfvars - copy to terraform.tfvars and adjust.
# terraform.tfvars is gitignored; commit only this example.
# =============================================================================

# Management-account profile for LOCAL runs (CI sets this to "" and uses OIDC).
management_account_profile = "mgt"

region = "eu-central-1"

# -----------------------------------------------------------------------------
# The module defaults are ORG-WIDE attachment + NO enforcement
# (enforced_resource_types = [], observe-only). You normally do NOT need to set
# attach_target_ids here -- the default in variables.tf already encodes the
# org-wide-minus-six scope.
# -----------------------------------------------------------------------------

# RE-ENABLE ENFORCEMENT (deliberately, a few services at a time). Tokens are
# listed in the comment on enforced_resource_types in variables.tf:
# enforced_resource_types = ["s3:ALL_SUPPORTED", "ec2:ALL_SUPPORTED"]

# NARROWER PILOT (optional): sandbox only, EC2 only. Uncomment BOTH to override
# the org-wide defaults:
# attach_target_ids       = ["ou-rzmo-bjyh9b48"]  # Sandbox-Managed
# enforced_resource_types = ["ec2:instance", "ec2:volume"]

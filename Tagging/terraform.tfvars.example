# =============================================================================
# Example terraform.tfvars - copy to terraform.tfvars and adjust.
# terraform.tfvars is gitignored; commit only this example.
# =============================================================================

# Management-account profile for LOCAL runs (CI sets this to "" and uses OIDC).
management_account_profile = "mgt"

region = "eu-central-1"

# -----------------------------------------------------------------------------
# The module defaults are ORG-WIDE attachment + BROAD enforcement (every
# service that supports tag-policy enforcement). You normally do NOT need to
# set attach_target_ids or enforced_resource_types here -- the defaults in
# variables.tf already encode the org-wide-minus-six scope and the full
# enforcement list. Override below only to NARROW scope.
# -----------------------------------------------------------------------------

# SAFER FIRST APPLY (recommended): attach org-wide but block NOTHING, so you can
# inspect the effective policy before enforcement rejects anything. Uncomment:
# enforced_resource_types = []

# NARROWER PILOT (optional): sandbox only, EC2 only. Uncomment BOTH to override
# the org-wide defaults:
# attach_target_ids       = ["ou-rzmo-bjyh9b48"]  # Sandbox-Managed
# enforced_resource_types = ["ec2:instance", "ec2:volume"]
